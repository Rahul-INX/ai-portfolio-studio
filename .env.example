DATABASE_URL=
# Local-only database used by `npm run prisma:push:local`. It must use localhost or 127.0.0.1.
LOCAL_DATABASE_URL=
# `npm run dev:local` sets this automatically from its local port.
NEXTAUTH_URL=
NEXTAUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Production defaults to Google-only when OAuth is configured. Enable only for emergency recovery.
ENABLE_CREDENTIALS_LOGIN=false
CLOUDINARY_CLOUD_NAME=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_KEYS_ENCRYPTION_KEY=
AI_DAILY_REQUEST_LIMIT=100
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/admin/google-drive/callback
# Optional separate OAuth client. Falls back to the Drive client above.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# Job Fit Intelligence research providers. Keep credentials out of this tracked file.
TAVILY_API_KEY=
TAVILY_MCP_SERVER_URL=https://mcp.tavily.com/mcp/
SCRAPE_DO_API_KEY=

# Job Fit Intelligence: generate a separate random 32-byte secret; do not reuse AI_KEYS_ENCRYPTION_KEY.
JOB_FIT_DATA_ENCRYPTION_KEY=

# Optional semantic-retrieval configuration.
JOB_FIT_EMBEDDING_PROVIDER=
JOB_FIT_EMBEDDING_MODEL=
