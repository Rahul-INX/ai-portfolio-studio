generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  PLANNED
  ACTIVE
  COMPLETED
  MAINTAINED
}

enum ContentType {
  PROJECT
  CASE_STUDY
  EXPERIMENT
  BLOG
  DASHBOARD
}

enum Visibility {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DocumentKind {
  RESUME
  CV
}

enum AiProviderType {
  GEMINI
  OPENAI
  ANTHROPIC
  XAI
}

enum MediaProvider {
  GOOGLE_DRIVE
}

enum JobFitInquiryStatus {
  QUEUED
  CORE_COMPLETE
  RESEARCHING
  COMPLETE
  FAILED
}

enum JobFitCredentialProvider {
  TAVILY
  SCRAPE_DO
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("ADMIN")
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id                 String        @id @default(cuid())
  slug               String        @unique
  title              String
  subtitle           String
  summary            String
  description        String
  status             ContentStatus @default(ACTIVE)
  visibility         Visibility    @default(PUBLISHED)
  techStack          String[]
  tags               String[]
  githubUrl          String?
  demoUrl            String?
  imageUrl           String?
  metrics            Json
  businessImpact     String
  architectureCanvas Json
  featured           Boolean       @default(false)
  startDate          DateTime?
  endDate            DateTime?
  publishedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model CaseStudy {
  id            String     @id @default(cuid())
  slug          String     @unique
  title         String
  summary       String
  problem       String
  context       String
  approach      String
  businessValue String
  tags          String[]
  imageUrl      String?
  visibility    Visibility @default(PUBLISHED)
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Experiment {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  summary     String
  hypothesis  String
  method      String
  findings    String
  nextStep    String
  status      ContentStatus @default(ACTIVE)
  tags        String[]
  metrics     Json
  imageUrl    String?
  visibility  Visibility    @default(PUBLISHED)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Blog {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  excerpt     String
  content     String
  tags        String[]
  readTime    Int
  seoTitle    String
  seoSummary  String
  imageUrl    String?
  visibility  Visibility @default(PUBLISHED)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Dashboard {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  summary     String
  embedUrl    String?
  imageUrl    String?
  tags        String[]
  visibility  Visibility @default(PUBLISHED)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Skill {
  id        String   @id @default(cuid())
  name      String
  category  String
  level     Int
  weight    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Certification {
  id        String   @id @default(cuid())
  title     String
  issuer    String
  issuedAt  DateTime?
  url       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Achievement {
  id          String     @id @default(cuid())
  title       String
  issuer      String
  category    String
  summary     String
  awardedAt   DateTime?
  proofUrl    String?
  imageUrl    String?
  imageRatio  String     @default("4/3")
  imageFocus  String     @default("50% 50%")
  highlighted Boolean    @default(false)
  sortOrder   Int        @default(0)
  visibility  Visibility @default(PUBLISHED)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([visibility, highlighted, sortOrder])
}

model TimelineEvent {
  id          String   @id @default(cuid())
  title       String
  period      String
  description String
  signal      String
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PortfolioDocument {
  id           String       @id @default(cuid())
  kind         DocumentKind @unique
  title        String
  description  String
  fileUrl      String
  versionLabel String?
  visibility   Visibility   @default(PUBLISHED)
  publishedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model SiteProfile {
  id                  String   @id @default("main")
  name                String
  initials            String
  role                String
  profileImageUrl     String?
  contactEmail        String?
  contactPhone        String?
  contactLocation     String?
  githubUrl           String?
  linkedinUrl         String?
  heroEyebrow         String
  heroTitle           String
  heroSummary         String
  primaryCtaLabel     String
  secondaryCtaLabel   String
  focusLabel          String
  focusValue          String
  styleLabel          String
  styleValue          String
  modelLabel          String
  modelValue          String
  explorerEyebrow     String
  explorerTitle       String
  explorerDescription String
  homeLatestEyebrow     String @default("")
  awardsEyebrow         String @default("")
  awardsTitle           String @default("")
  awardsDescription     String @default("")
  homeSystemsEyebrow    String @default("")
  homeSystemsTitle      String @default("")
  homeSystemsDescription String @default("")
  resumeDownloadsEyebrow String @default("")
  resumeDownloadsTitle   String @default("")
  resumeDownloadsDescription String @default("")
  downloadResumeLabel    String @default("")
  downloadCvLabel        String @default("")
  viewCvLabel            String @default("")
  contactCtaLabel        String @default("")
  skillsTitle            String @default("")
  certificationsTitle    String @default("")
  cvHeadingEyebrow       String @default("")
  cvSummaryTitle         String @default("")
  cvProjectsTitle        String @default("")
  cvExperienceTitle      String @default("")
  cvCertificationsTitle  String @default("")
  navExplorerLabel       String @default("")
  navExperienceLabel     String @default("")
  navResumeLabel         String @default("")
  navJobFitLabel         String @default("")
  adminCmsLabel          String @default("")
  jobFitEyebrow          String @default("")
  jobFitTitle            String @default("")
  jobFitDescription      String @default("")
  jobFitOutputTitle      String @default("")
  jobFitOutputDescription String @default("")
  jobFitCriteriaEyebrow  String @default("")
  jobFitCriteriaTitle    String @default("")
  jobFitEvidenceEyebrow  String @default("")
  jobFitEvidenceTitle    String @default("")
  jobFitGapTitle         String @default("")
  jobFitProbeTitle       String @default("")
  jobFitMethodologyTitle String @default("")
  jobFitBuildTitle       String @default("")
  jobFitBuildDescription String @default("")
  jobFitTemplateTitle    String @default("")
  jobFitTemplateDescription String @default("")
  jobFitFormTitle        String @default("")
  jobFitPasteLabel       String @default("")
  jobFitAttachLabel      String @default("")
  jobFitAttachHelp       String @default("")
  jobFitEphemeralLabel   String @default("")
  jobFitGenerateLabel    String @default("")
  jobFitRegenerateLabel  String @default("")
  jobFitEditLabel        String @default("")
  jobFitCloseLabel       String @default("")
  jobFitRunningLabel     String @default("")
  jobFitFinalizingLabel  String @default("")
  jobFitLoadingTitle     String @default("")
  jobFitLoadingEyebrow   String @default("")
  jobFitLoadingDescription String @default("")
  jobFitStatScoreLabel   String @default("")
  jobFitStatRubricLabel  String @default("")
  jobFitStatEvidenceLabel String @default("")
  jobFitStrengthsTitle   String @default("")
  jobFitRisksTitle       String @default("")
  jobFitNextStepTitle    String @default("")
  jobFitRequirementLabel String @default("")
  jobFitPriorityLabel    String @default("")
  jobFitEvidenceColumnLabel String @default("")
  jobFitScoreLabel       String @default("")
  jobFitShowAllLabel     String @default("")
  jobFitCitedSourceLabel String @default("")
  jobFitNoEvidenceLabel  String @default("")
  jobFitNoGapLabel       String @default("")
  jobFitProceedStrongLabel String @default("")
  jobFitProceedFocusLabel String @default("")
  jobFitProceedCautionLabel String @default("")
  jobFitProceedInsufficientLabel String @default("")
  jobFitSpecialistAnalysisLabel String @default("")
  jobFitDeterministicAnalysisLabel String @default("")
  jobFitAlignedCriteriaLabel String @default("")
  jobFitNeedValidationLabel String @default("")
  jobFitCitedSourcesLabel   String @default("")
  timelineEyebrow     String
  timelineTitle       String
  timelineDescription String
  adminEyebrow        String
  adminTitle          String
  adminDescription    String
  seoTitle            String
  seoDescription      String
  ogTopLabel          String @default("")
  ogCenterLabel       String @default("")
  ogFooterLabel       String @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model JobFitSettings {
  id                           String   @id @default("main")
  deterministicFallbackEnabled Boolean  @default(true)
  fallbackTimeoutSeconds       Int      @default(120)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model JobFitInquiry {
  id                 String              @id @default(cuid())
  sessionHash        String
  contactEmail       String?
  company            String?
  role               String?
  location           String?
  status             JobFitInquiryStatus @default(QUEUED)
  jdEncryptedValue   String?
  jdIv               String?
  jdAuthTag          String?
  fileName           String?
  sourceContentType  String?
  sourceEncryptedValue String?
  sourceIv           String?
  sourceAuthTag      String?
  coreResult         Json?
  researchResult     Json?
  completedAt        DateTime?
  expiresAt          DateTime
  pinnedAt           DateTime?
  publicApprovedAt   DateTime?
  briefAssetId       String?             @unique
  sourceAssetId      String?             @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  events             JobFitStageEvent[]
  chats              JobFitChatMessage[]
  shareLinks         JobFitShareLink[]
  briefAsset         MediaAsset?         @relation("JobFitRecruiterBrief", fields: [briefAssetId], references: [id], onDelete: SetNull)
  sourceAsset        MediaAsset?         @relation("JobFitSourceDocument", fields: [sourceAssetId], references: [id], onDelete: SetNull)

  @@index([sessionHash, createdAt])
  @@index([status, createdAt])
  @@index([expiresAt])
  @@index([publicApprovedAt, createdAt])
}

model JobFitShareLink {
  id        String        @id @default(cuid())
  inquiryId String
  tokenHash String        @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime      @default(now())
  inquiry   JobFitInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId, expiresAt])
}

model JobFitStageEvent {
  id        String        @id @default(cuid())
  inquiryId String
  stage     String
  status    String
  detail    String
  createdAt DateTime      @default(now())
  inquiry   JobFitInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId, createdAt])
}

model JobFitChatMessage {
  id        String        @id @default(cuid())
  inquiryId String
  role      String
  content   String
  citations Json?
  createdAt DateTime      @default(now())
  inquiry   JobFitInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId, createdAt])
}

model JobFitCredential {
  provider       JobFitCredentialProvider @id
  encryptedValue String
  iv             String
  authTag        String
  keyHint        String
  enabled        Boolean                  @default(true)
  updatedAt      DateTime                 @updatedAt
  createdAt      DateTime                 @default(now())
}

model ReadingEvent {
  id          String      @id @default(cuid())
  contentType ContentType
  slug        String
  depth       Int
  referrer    String?
  userAgent   String?
  createdAt   DateTime    @default(now())
}

model StoredFile {
  id          String   @id @default(cuid())
  fileName    String
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model DriveConnection {
  id             String   @id @default("main")
  accountEmail   String?
  encryptedValue String
  iv             String
  authTag        String
  rootFolderId   String
  folderIds      Json
  connectedAt    DateTime @default(now())
  lastVerifiedAt DateTime?
  updatedAt      DateTime @updatedAt
}

model MediaAsset {
  id          String        @id @default(cuid())
  provider    MediaProvider @default(GOOGLE_DRIVE)
  externalId  String        @unique
  fileName    String
  contentType String
  size        Int
  folder      String
  createdAt   DateTime      @default(now())
  trashedAt   DateTime?
  jobFitBrief JobFitInquiry? @relation("JobFitRecruiterBrief")
  jobFitSource JobFitInquiry? @relation("JobFitSourceDocument")

  @@index([folder, createdAt])
}

model AiProviderConfig {
  id                String         @id @default(cuid())
  provider          AiProviderType @unique
  enabled           Boolean        @default(false)
  priority          Int
  selectedModel     String?
  maxOutputTokens   Int            @default(4096)
  dailyRequestLimit Int            @default(100)
  keys              AiApiKey[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model AiApiKey {
  id             String           @id @default(cuid())
  providerId     String
  label          String
  encryptedValue String
  iv             String
  authTag        String
  keyHint        String
  enabled        Boolean          @default(true)
  priority       Int              @default(0)
  lastTestedAt   DateTime?
  lastTestStatus String?
  provider       AiProviderConfig @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([providerId, enabled, priority])
}

model AiUsageBucket {
  provider  AiProviderType
  day       DateTime       @db.Date
  count     Int            @default(0)
  updatedAt DateTime       @updatedAt

  @@id([provider, day])
}
